@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <h1 class="display-5">Welcome back, @User.Identity.Name</h1>
        <p class="lead">Ready to log some time?</p>
        <a class="btn btn-primary btn-lg" asp-controller="Activities" asp-action="Track">Track an activity</a>
    }
    else
    {
        <h1 class="display-4">TimeTracker</h1>
        <p class="lead">Log in to start tracking your activities.</p>
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Signup">Sign up</a>
    }
</div>
